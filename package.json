{
  "name": "goodwork-project-management",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"tsx watch server/src/main.ts\" \"vite --config client/vite.config.ts\"",
    "dev:web": "vite --config client/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build --config client/vite.config.ts",
    "start": "tsx server/src/main.ts",
    "auth:bootstrap": "tsx server/src/scripts/bootstrap-admin.ts",
    "db:upgrade-task-recycle": "tsx server/src/scripts/upgrade-task-recycle.ts",
    "test:performance": "tsx tests/performance/run.ts",
    "test:performance:smoke": "tsx tests/performance/suite.ts --profile smoke",
    "test:performance:full": "tsx tests/performance/suite.ts --profile full",
    "test:performance:browser": "tsx tests/performance/browser.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "better-sqlite3": "^12.0.0",
    "echarts": "^6.1.0",
    "fastify": "^5.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
